{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildplatform.local/schemas/form-schema.schema.json",
  "title": "构建平台配置表单模板",
  "description": "管理员上传的配置表单模板。跨字段语义规则由运行时校验器补充。",
  "type": "array",
  "items": { "$ref": "#/$defs/formField" },
  "$defs": {
    "fieldName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
    "plainText": { "type": "string" },
    "optionValue": { "type": ["string", "number"] },
    "option": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/optionValue" }
      }
    },
    "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } },
    "common": {
      "type": "object",
      "required": ["type", "name", "label"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "$ref": "#/$defs/plainText", "minLength": 1 },
        "defaultValue": {},
        "required": { "type": "boolean" },
        "placeholder": { "$ref": "#/$defs/plainText" },
        "description": { "$ref": "#/$defs/plainText" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "inputField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "input" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "maxLength": 512 }
      }
    },
    "textareaField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "textarea" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 }
      }
    },
    "numberField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "number" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "number" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "selectField": {
      "type": "object",
      "required": ["type", "name", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "select" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "$ref": "#/$defs/optionValue" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "radioField": {
      "type": "object",
      "required": ["type", "name", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "radio" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "$ref": "#/$defs/optionValue" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "checkboxField": {
      "type": "object",
      "required": ["type", "name", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "checkbox" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": {
          "type": "array",
          "items": { "$ref": "#/$defs/optionValue" },
          "uniqueItems": true
        },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "options": { "$ref": "#/$defs/options" }
      }
    },
    "switchField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "switch" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "boolean" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "dateField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "date" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "passwordField": {
      "type": "object",
      "required": ["type", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "password" },
        "name": { "$ref": "#/$defs/fieldName" },
        "label": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string" },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" },
        "disabled": { "type": "boolean" },
        "sensitive": { "const": true }
      }
    },
    "formField": {
      "oneOf": [
        { "$ref": "#/$defs/inputField" },
        { "$ref": "#/$defs/textareaField" },
        { "$ref": "#/$defs/numberField" },
        { "$ref": "#/$defs/selectField" },
        { "$ref": "#/$defs/radioField" },
        { "$ref": "#/$defs/checkboxField" },
        { "$ref": "#/$defs/switchField" },
        { "$ref": "#/$defs/dateField" },
        { "$ref": "#/$defs/passwordField" }
      ]
    }
  },
  "x-runtimeOnlyRules": [
    "同一模板内 name 必须唯一",
    "options 值必须唯一",
    "pattern 必须可编译",
    "约束范围必须一致",
    "纯文本不得含控制字符或 HTML/XML 标签",
    "date 必须是有效日历日期"
  ]
}
