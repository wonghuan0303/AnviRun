# Windows 内网 Server 环境示例。只含占位值，部署前必须替换数据库连接和两个独立密钥。
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
DATABASE_URL=postgresql://buildplatform:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:54329/buildplatform_prod?schema=public

# 生产环境必须显式配置两个不同的高复杂度随机密钥（至少 32 字节）。
ACCESS_TOKEN_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
REFRESH_TOKEN_HASH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
TOKEN_ISSUER=buildplatform-server
TOKEN_AUDIENCE=buildplatform-web

# 精简版可信内网 HTTP 模式：仅当 Secure=false、Cookie 非 __Host- 且 SameSite=Strict 时启用。
# 接入 HTTPS 后必须关闭 ALLOW_INSECURE_HTTP、恢复 AUTH_COOKIE_SECURE=true 和 __Host- Cookie。
ALLOW_INSECURE_HTTP=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_NAME=buildplatform_refresh
AUTH_CSRF_COOKIE_NAME=buildplatform_csrf

ARTIFACT_STORAGE_ROOT=C:/BuildPlatform/data/artifacts
TASK_LOG_ROOT=C:/BuildPlatform/data/task-logs
WEB_STATIC_ROOT=C:/BuildPlatform/app/web
