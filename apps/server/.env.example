# apps/server 本地环境变量示例
# 真实 .env 已被 .gitignore 忽略，禁止提交真实账号、密码或令牌。
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DATABASE_URL=postgresql://buildplatform:buildplatform_dev_only@127.0.0.1:54329/buildplatform_dev?schema=public

# 开发环境仅使用本地占位密钥；生产环境必须显式配置两个相互独立、至少 32 字节的高复杂度随机密钥。
# 生产环境会拒绝重复字符、示例值、占位值以及开发/测试固定值。
ACCESS_TOKEN_SECRET=buildplatform-dev-only-access-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_HASH_SECRET=buildplatform-dev-only-refresh-hash-secret-change-me
TOKEN_ISSUER=buildplatform-server
TOKEN_AUDIENCE=buildplatform-web

# HTTP 开发环境可为 false；生产环境必须为 true，并使用 HTTPS。
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_NAME=buildplatform_refresh
AUTH_CSRF_COOKIE_NAME=buildplatform_csrf

# 第一版是单实例进程内限流；窗口结束或进程重启后计数清空。
LOGIN_RATE_LIMIT_WINDOW=5m
LOGIN_RATE_LIMIT_MAX=5
