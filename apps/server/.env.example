# apps/server 本地环境变量示例
# 使用方式：cp .env.example .env（.env 已在 .gitignore 中，禁止提交）
# 本文件只允许出现占位值，禁止写入真实账号、密码或令牌。

# 运行环境：development | test | production
NODE_ENV=development

# HTTP 监听地址。默认 127.0.0.1，仅监听本机；容器或需要外部访问时改为 0.0.0.0
SERVER_HOST=127.0.0.1

# HTTP 监听端口
SERVER_PORT=3000

# PostgreSQL 连接串。默认指向仓库提供的本地 Docker Compose 开发数据库。
DATABASE_URL=postgresql://buildplatform:buildplatform_dev_only@127.0.0.1:54329/buildplatform_dev?schema=public
